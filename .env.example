# Browser Use: Jev decisions plus at least one provider for text and vision.
TYPESAFE_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Automatic failover uses configured Fireworks, OpenRouter, OpenAI, Anthropic keys.
# Pin a single provider to prevent failover and enable generic model overrides:
# BROWSER_USE_PROVIDER=fireworks
# BROWSER_USE_MODEL=accounts/fireworks/models/kimi-k3
# BROWSER_USE_TEXT_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Automatic mode instead uses provider-specific overrides:
# BROWSER_USE_OPENROUTER_MODEL=openai/gpt-5.4

# Legacy ultrafast engine optional explicit override (set its key and URL together):
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_REASONING=none

# Planned engine: restrict these lists to control which providers receive page text/screenshots.
CLICKER_PLANNER_PROVIDERS=openai,openrouter,anthropic,fireworks
CLICKER_WRITER_PROVIDERS=openai,anthropic,fireworks,openrouter
CLICKER_PLANNER_REASONING=low

# See docs/writer-endpoints.md for model and custom endpoint overrides.
# CLICKER_PLANNER_OPENAI_MODEL=gpt-5.4-mini
# CLICKER_OPENAI_MODEL=gpt-4.1-nano

# Optional fast-loop recovery and text failover
# RECOVERY_MODEL=openai/gpt-4.1-mini
# TEXT_MODEL_FALLBACKS=openrouter,openai,fireworks
